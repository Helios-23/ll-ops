KC_DB=postgres
KC_DB_URL=jdbc:postgresql://database:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD={{ keycloak_credentials.database_password }}
KC_BOOTSTRAP_ADMIN_USERNAME={{ keycloak_admin_user }}
KC_BOOTSTRAP_ADMIN_PASSWORD={{ keycloak_credentials.admin_password }}
KC_HOSTNAME={{ keycloak_hostname }}
KC_HTTP_ENABLED=false
KC_HTTPS_CERTIFICATE_FILE=/opt/keycloak/conf/tls/fullchain.pem
KC_HTTPS_CERTIFICATE_KEY_FILE=/opt/keycloak/conf/tls/privkey.pem
KC_HEALTH_ENABLED=true
KC_HTTP_MANAGEMENT_SCHEME=http
{% if keycloak_proxy_headers %}
KC_PROXY_HEADERS={{ keycloak_proxy_headers }}
{% endif %}
KC_HTTPS_CERTIFICATES_RELOAD_PERIOD=5m
