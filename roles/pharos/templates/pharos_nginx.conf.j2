upstream pharos_app {
{% if pharos_use_socket %}
    server unix:{{ pharos_socket_path }};
{% else %}
    server {{ pharos_service_host }}:{{ pharos_service_port }};
{% endif %}
}

server {
    listen 80;
    server_name {{ domain_list | map(attribute='name') | join(' ') }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

{% for domain in domain_list %}
server {
    listen 443 ssl http2;
    server_name {{ domain.name }};

    ssl_certificate /etc/letsencrypt/live/{{ domain.name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain.name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    access_log {{ pharos_access_log }};
    error_log {{ pharos_error_log }};

    client_max_body_size 128M;

{% if domain.root_url != '/' %}
    location = / {
        return 301 {{ domain.root_url }};
    }

{% if not domain.root_url.endswith('/') %}
    location = {{ domain.root_url }} {
        return 301 {{ domain.root_url }}/;
    }
{% else %}
    location = {{ domain.root_url[:-1] }} {
        return 301 {{ domain.root_url }};
    }
{% endif %}
{% endif %}

{% if domain.legacy_root_url is defined %}
    location = {{ domain.legacy_root_url }} {
        return 301 /;
    }

    location = {{ domain.legacy_root_url }}/ {
        return 301 /;
    }
{% endif %}

{% if domain.favicon_url is defined %}
    location = /favicon.ico {
        return 302 {{ domain.favicon_url }};
    }
{% endif %}

    location / {
        proxy_pass http://pharos_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 600s;
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
    }
}
{% endfor %}
