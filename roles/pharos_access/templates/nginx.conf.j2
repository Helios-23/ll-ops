{% if pharos_access_tls %}
log_format pharos_access_safe '$remote_addr $status $request_method $uri $body_bytes_sent $request_time';
{% endif %}
server {
    listen 80;
    server_name {{ pharos_access_hostname }};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/pharos-access-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
{% if pharos_access_tls %}
        return 301 https://{{ pharos_access_hostname }}$request_uri;
{% else %}
        return 404;
{% endif %}
    }
}
{% if pharos_access_tls %}
server {
    listen 443 ssl http2;
    server_name {{ pharos_access_hostname }};
    ssl_certificate /etc/letsencrypt/live/{{ pharos_access_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ pharos_access_hostname }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    access_log /var/log/nginx/pharos-access.access.log pharos_access_safe;
    error_log /var/log/nginx/pharos-access.error.log crit;
    location / {
        proxy_pass http://127.0.0.1:7624;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host {{ pharos_access_hostname }};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host {{ pharos_access_hostname }};
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Prefix "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
{% endif %}
