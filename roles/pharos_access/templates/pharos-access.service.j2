[Unit]
Description=Pharos subscription access service
After=network-online.target keycloak.service
Wants=network-online.target

[Service]
Type=simple
User=pharos-access
Group=pharos-access
EnvironmentFile=/etc/pharos-access/service.env
ExecStart=/opt/pharos-access/current/bin/pharos_access_service --conf /etc/pharos-access/service.json
WorkingDirectory=/var/lib/pharos-access
StateDirectory=pharos-access
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=384M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
