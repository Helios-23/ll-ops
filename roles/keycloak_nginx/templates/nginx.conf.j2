{% if keycloak_nginx_tls %}
log_format keycloak_safe '$remote_addr $status $request_method $uri $body_bytes_sent $request_time';
{% endif %}
server {
    listen 80;
    server_name {{ keycloak_nginx_hostname }};
    location ^~ /.well-known/acme-challenge/ {
        root {{ keycloak_nginx_acme_root }};
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
{% if keycloak_nginx_tls %}
        return 301 https://{{ keycloak_nginx_hostname }}$request_uri;
{% else %}
        return 404;
{% endif %}
    }
}
{% if keycloak_nginx_tls %}
server {
    listen 443 ssl http2;
    server_name {{ keycloak_nginx_hostname }};
    ssl_certificate /etc/letsencrypt/live/{{ keycloak_nginx_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ keycloak_nginx_hostname }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;
    access_log /var/log/nginx/keycloak.access.log keycloak_safe;
    error_log /var/log/nginx/keycloak.error.log;
    location / {
        proxy_pass https://127.0.0.1:{{ keycloak_https_port }};
        proxy_ssl_server_name on;
        proxy_ssl_name {{ keycloak_nginx_hostname }};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host {{ keycloak_nginx_hostname }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host {{ keycloak_nginx_hostname }};
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
{% endif %}
