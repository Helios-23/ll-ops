#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)

python3 "$repo_root/bin/check_ansible_vault_encryption.py" --staged

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "secret scan unavailable: install gitleaks before committing" >&2
  echo "macOS: brew install gitleaks" >&2
  exit 1
fi

cd "$repo_root"
gitleaks git --pre-commit --staged --redact --no-banner
